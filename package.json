{
  "name": "dsh-wechat-ai-bridge",
  "version": "0.2.3",
  "description": "DeepSeek Harness ↔ WeChat bridge for the wechat-ai MCP server",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wechat",
    "wechat-ai",
    "mcp",
    "bridge",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Windfarer/dsh-wechat-ai-bridge.git"
  },
  "homepage": "https://github.com/Windfarer/dsh-wechat-ai-bridge#readme",
  "bugs": {
    "url": "https://github.com/Windfarer/dsh-wechat-ai-bridge/issues"
  }
}
